<!DOCTYPE html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SVE - Gestão de Candidatos</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        background-color: #f4f7f6;
        font-family: "Segoe UI", sans-serif;
      }
      .card-admin {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }
      .btn-registo {
        font-weight: 600;
        padding: 12px;
        border-radius: 10px;
      }
    </style>
  </head>
  <body>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card card-admin p-4">
            <h2 class="text-center mb-4 text-primary">Criar nova eleição</h2>
            <p class="text-center text-muted mb-4">
              Preencha os dados abaixo para adicionar um candidato à eleição
              ativa.
            </p>

            <form id="formCandidato">
              <div class="mb-3">
                <label class="form-label fw-bold">Logotipo da eleição</label>
                <input
                  type="file"
                  id="foto"
                  class="form-control"
                  accept="image/*"
                  required
                />
                <div class="form-text">Formatos aceites: JPG, PNG.</div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Nome da eleição</label>
                <input
                  type="text"
                  id="nome_eleicao"
                  class="form-control"
                  placeholder="Ex: Eleição presidencial 2024"
                  required
                />
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">Descrição (opcional)</label>
                  <input
                    type="text"
                    id="descricao_eleicao"
                    class="form-control"
                    placeholder="Escreva uma breve descrição"
                  />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">Data de inicio</label>
                  <input type="date" id="data_inicio" class="form-control" />
                </div>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Data do fim</label>
                <input type="date" id="data_fim" class="form-control" />
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Estado</label>
                <select id="estado_eleicao" class="form-selct">
                  <option value="">Não especificado</option>
                  <option value="">Ativa</option>
                  <option value="">Encerrada</option>
                </select>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Tipo de eleição</label>
                <select id="estado_eleicao" class="form-selct">
                  <option value="">Não especificado</option>
                  <option value="">Legislativa</option>
                  <option value="">Presidenciais</option>
                  <option value="">Personalizada</option>
                </select>
              </div>

              <!-- Botão Submeter -->
              <button
                type="submit"
                class="btn btn-primary w-100 btn-registo mt-3"
              >
                Criar eleição
              </button>

              <a
                href="login.html"
                class="btn btn-link w-100 mt-2 text-decoration-none text-muted"
                >Voltar ao Início</a
              >
            </form>
          </div>
        </div>
      </div>
    </div>

    <script></script>
  </body>
</html>
